{
  "manifest_version": 3,
  "name": "Grasp",
  "version": "0.1.0",
  "description": "Capta la estructura del ingles: traduccion por bloques semanticos sobre cualquier texto de la web.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Grasp",
    "default_icon": {
      "16": "icons/tb16.png",
      "32": "icons/tb32.png",
      "48": "icons/tb48.png",
      "128": "icons/tb128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-hover": {
      "suggested_key": { "default": "Alt+G", "mac": "Alt+G" },
      "description": "Activar/desactivar el modo hover de Grasp"
    }
  }
}
